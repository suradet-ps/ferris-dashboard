# PostgreSQL connection string for the ingestion worker and web API.
# Example: postgres://ferris:ferris@localhost:5432/ferris_dashboard
DATABASE_URL=postgres://ferris:ferris@localhost:5432/ferris_dashboard

# Optional GitHub token (increases the API rate limit from 60 to 5000 req/h).
GITHUB_TOKEN=

# Bind address of the dashboard web server.
SITE_ADDR=127.0.0.1:3000

# Source refresh intervals in minutes. Overrides defaults when set.
# INGEST_INTERVAL_GITHUB=10
# INGEST_INTERVAL_CRATES=15
# INGEST_INTERVAL_RSS=30
# INGEST_INTERVAL_RUSTSEC=360
# INGEST_INTERVAL_RFC=360

# Enable/disable sources.
# SOURCE_GITHUB_ENABLED=true
# SOURCE_CRATES_ENABLED=true
# SOURCE_RSS_ENABLED=true
# SOURCE_RUSTSEC_ENABLED=true
# SOURCE_RFC_ENABLED=true
